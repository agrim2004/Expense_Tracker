# Backend Port (assigned automatically by cloud hosts like Render/Railway)
PORT=5000

# Node Environment ('production' or 'development')
NODE_ENV=production

# MongoDB Atlas URI (Get from https://cloud.mongodb.com)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/expense_tracker?retryWrites=true&w=majority

# JWT Secret Key (Any long random string)
JWT_SECRET=your_super_secret_jwt_key_here_change_this

# Frontend URL (optional, only needed if deploying frontend on separate domain like Vercel)
CLIENT_URL=https://your-frontend-domain.vercel.app
